#===============================================================================
# OPOH SYSTEM CONFIGURATION (ระบบบริหารจัดการเตียง ห้องผ่าตัด ห้องคลอด คิวผ่าตัด)
#===============================================================================

#-------------------------------------------------------------------------------
# 1. System & Hospital Settings (ข้อมูลหน่วยบริการและระบบ)
# ผู้ใช้ต้องกำหนด: รหัสโรงพยาบาล 5 หลัก และชื่อโรงพยาบาลของคุณ
#-------------------------------------------------------------------------------
APP_PORT=3000
NEXT_PUBLIC_HOSPITAL_CODE=10709
NEXT_PUBLIC_HOSPITAL_NAME=KALASIN
NEXT_PUBLIC_HOSPITAL_FULL_NAME=โรงพยาบาลกาฬสินธุ์

#-------------------------------------------------------------------------------
# 2. Central API Settings (การเชื่อมโยงระบบศูนย์กลาง สสจ. กาฬสินธุ์)
# ขอรับ API Token ได้ที่: https://appksn.moph.go.th/opoh/
#-------------------------------------------------------------------------------
OPOH_BASE_URL=https://appksn.moph.go.th/opoh/api/v1
API_KEY=YOUR_OPOH_API_KEY
# ช่องทางเข้าดู API Token: https://appksn.moph.go.th/opoh/

#-------------------------------------------------------------------------------
# 3. HOSxP Database Settings (การเชื่อมต่อฐานข้อมูล HOSxP ต้นทาง)
# - กรณีรันบน Node.js / Server ทั่วไป: ระบุ IP ของเครื่อง HOSxP เช่น 192.168.1.100
# - กรณีรันบน Docker และ HOSxP อยู่บนเครื่อง Host เดียวกัน: ใช้ host.docker.internal
#-------------------------------------------------------------------------------
HOSXP_DB_HOST=192.168.x.x
HOSXP_DB_PORT=3306
HOSXP_DB_USER=sa
HOSXP_DB_PASSWORD=YOUR_HOSXP_PASSWORD
HOSXP_DB_NAME=hos
HOSXP_DB_CHARSET=utf8mb4

#-------------------------------------------------------------------------------
# 4. Local Database Settings (ฐานข้อมูลแคชภายใน OPOH / AppServ / XAMPP / MariaDB)
# - รองรับทั้ง:
#   a) Docker opoh-db Container (ระบุ LOCAL_DB_HOST=opoh-db หรือ 127.0.0.1)
#   b) ฐานข้อมูลบนเครื่องแม่ข่าย Host เช่น AppServ, XAMPP, MariaDB (พอร์ต 3306 หรือพอร์ตอื่นๆ)
#      (ระบบ Docker มี Smart Gateway Map 127.0.0.1 / localhost ไปยัง host.docker.internal ให้อัตโนมัติ)
# - LOCAL_DB_PORT_MAP: พอร์ตภายนอกสำหรับต่อ Navicat / DBeaver เข้ามาดูข้อมูล (ค่าเริ่มต้น 3307)
#-------------------------------------------------------------------------------
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=opoh_user
LOCAL_DB_PASSWORD=YOUR_LOCAL_DB_PASSWORD
LOCAL_DB_NAME=db_opoh
LOCAL_DB_PORT_MAP=3307

#-------------------------------------------------------------------------------
# 5. Administrative Rights (การกำหนดสิทธิ์ผู้ดูแลระบบ)
# ระบบตรวจจับ Admin จากตาราง opduser ของ HOSxP ให้อัตโนมัติ และสามารถระบุ Username เพิ่มเติมได้:
#-------------------------------------------------------------------------------
ADMIN_USERNAMES=admin,sa,bmsadmin,ict,it

#-------------------------------------------------------------------------------
# 6. Security & Session Settings (ความปลอดภัยและการเข้ารหัส)
# - JWT_SECRET: สตริงสุ่มความยาวอย่างน้อย 32 ตัวอักษรสำหรับเข้ารหัส Session
# - COOKIE_SECURE: ตั้งเป็น false หากเปิดผ่าน HTTP ในวง LAN / ตั้งเป็น true หากใช้ HTTPS
#-------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_random_key_min_32_chars
COOKIE_SECURE=false
