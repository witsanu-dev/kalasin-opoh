#==========================================
# OPOH SYNC SYSTEM CONFIGURATION
#==========================================
# 1. System & Hospital Settings
APP_PORT=3000
NEXT_PUBLIC_HOSPITAL_NAME=YOUR_HOSPITAL_NAME
NEXT_PUBLIC_HOSPITAL_CODE=YOUR_HOSPITAL_CODE
NEXT_PUBLIC_HOSPITAL_FULL_NAME=โรงพยาบาลของคุณ

# 2. Central API Settings
OPOH_BASE_URL=https://appksn.moph.go.th/opoh/api/v1
API_KEY=your_secure_api_key_here

# 3. HOSxP Database Settings (Source)
# If HOSxP runs on the same server as Docker, use: host.docker.internal
# If HOSxP runs on another server on LAN, use its LAN IP (e.g. 192.168.1.100)
HOSXP_DB_HOST=192.168.x.x
HOSXP_DB_PORT=3306
HOSXP_DB_USER=sa
HOSXP_DB_PASSWORD=your_hosxp_password
HOSXP_DB_NAME=hos
HOSXP_DB_CHARSET=utf8mb4

# 4. Local Database Settings (Cache/Sync)
# For Node.js / Local Dev / Standalone: use '127.0.0.1'
# (Note: Docker Compose automatically connects to 'opoh-db' container internally)
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=opoh_user
LOCAL_DB_PASSWORD=opoh_secure_password
LOCAL_DB_NAME=db_opoh
LOCAL_DB_PORT_MAP=3307

# 5. Administrative Rights (Universal Multi-Hospital Standards)
# The system automatically detects Admin from HOSxP opduser (groups like 'admin', 'administrator', 'ศูนย์คอม',
# accessright '[ADMIN]', and positions like 'นักวิชาการคอมพิวเตอร์').
# You can also whitelist hospital-specific admin usernames (separated by comma):
ADMIN_USERNAMES=admin,sa,bmsadmin,ict,it,witsanu.ict

# 6. Security & Authentication Settings
# Generate a secret random string (minimum 32 characters) for JWT session encryption:
JWT_SECRET=opoh_jwt_secret_key_change_me_in_production
# Set to 'false' if accessing via plain HTTP (e.g. http://192.168.x.x:3000)
# Set to 'true' if running behind HTTPS / Reverse Proxy with SSL (e.g. https://opoh.hospital.moph.go.th)
COOKIE_SECURE=false

