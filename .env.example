# 1. System & Hospital Settings
APP_PORT=46
NEXT_PUBLIC_HOSPITAL_CODE=YOUR_HOSPITAL_CODE
NEXT_PUBLIC_HOSPITAL_NAME=YOUR_HOSPITAL_NAME
NEXT_PUBLIC_HOSPITAL_FULL_NAME=โรงพยาบาลของคุณ

# 2. Central API Settings
